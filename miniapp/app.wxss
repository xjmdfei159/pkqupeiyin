page {
  background: #f6f7fb;
  color: #1f2329;
  font-size: 28rpx;
}

.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.title {
  font-size: 34rpx;
  font-weight: 600;
}

.subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #5c6370;
}

.btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
