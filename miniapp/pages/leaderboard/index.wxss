.page {
  min-height: 100vh;
  background: #4b4d56;
  padding: 60rpx 28rpx 40rpx;
  box-sizing: border-box;
}

.rank-title {
  text-align: center;
  color: #fff;
  font-size: 46rpx;
  font-weight: 700;
  margin-bottom: 28rpx;
}

.rank-board {
  background: linear-gradient(180deg, rgba(28, 31, 40, 0.94), rgba(19, 21, 29, 0.96));
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  overflow: hidden;
}

.board-header {
  color: #8a93a3;
  font-size: 24rpx;
  padding: 18rpx 22rpx 14rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.rank-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.rank-row:last-child {
  border-bottom: 0;
}

.left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.rank {
  width: 44rpx;
  color: #f6b02f;
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
}

.rank-1 {
  color: #ffcf4a;
}

.rank-2 {
  color: #ffd66d;
}

.rank-3 {
  color: #ffdf92;
}

.avatar {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #e6e6e6;
  color: #535862;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user {
  color: #eef1f5;
  font-size: 34rpx;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.score {
  color: #f6f7f9;
  font-size: 40rpx;
  font-weight: 700;
}

.empty,
.loading {
  color: #d3d7df;
  text-align: center;
  padding: 36rpx 0;
}
