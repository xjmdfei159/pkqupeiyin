.page {
  min-height: 100vh;
  background: #eef1f4;
  padding-bottom: 20rpx;
}

.video-section {
  position: relative;
}

.video-player {
  width: 100%;
  height: 420rpx;
  background: #101114;
}

.video-mask {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 20rpx;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.55);
}

.video-title {
  font-size: 36rpx;
  font-weight: 700;
}

.video-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.action-bar {
  display: flex;
  gap: 16rpx;
  padding: 18rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #edf0f5;
}

.ghost-btn {
  flex: 1;
}

.subtitle-panel {
  margin: 18rpx 16rpx;
}

.panel-header {
  color: #606875;
  font-size: 24rpx;
  margin: 8rpx 10rpx 12rpx;
}

.line-item {
  background: #fff;
  border-radius: 18rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.line-main {
  flex: 1;
  min-width: 0;
}

.line-index {
  font-size: 22rpx;
  color: #8e96a3;
}

.line-text {
  margin-top: 8rpx;
  font-size: 42rpx;
  line-height: 1.3;
  color: #1f2329;
  font-weight: 600;
}

.line-transcript {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8a919f;
}

.line-meta {
  margin-top: 12rpx;
  display: flex;
  justify-content: space-between;
  color: #6e7684;
  font-size: 22rpx;
}

.mic-btn {
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  background: #2ed24a;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(46, 210, 74, 0.35);
  flex-shrink: 0;
}

.mic-btn-recording {
  background: #ff5b5b;
  box-shadow: 0 10rpx 24rpx rgba(255, 91, 91, 0.35);
}

.mic-icon {
  color: #fff;
  font-size: 36rpx;
  line-height: 1;
}

.submit-wrap {
  padding: 0 24rpx;
}

.result-card {
  margin: 18rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
}

.result-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}
