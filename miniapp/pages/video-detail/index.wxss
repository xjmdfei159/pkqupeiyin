.video-id {
  margin-top: 8rpx;
  color: #8a919f;
  font-size: 22rpx;
}

.line-head {
  font-weight: 600;
  font-size: 28rpx;
}

.expected {
  margin-top: 8rpx;
  color: #5c6370;
  font-size: 24rpx;
}

.line-btn-row {
  margin-top: 16rpx;
  display: flex;
  gap: 16rpx;
}

.line-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #3d4350;
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.line-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a919f;
}

.result-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.line-score-title {
  margin-top: 16rpx;
  margin-bottom: 8rpx;
  color: #5c6370;
}

.line-score-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8a919f;
  word-break: break-all;
}
