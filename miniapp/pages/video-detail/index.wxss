.page {
  min-height: 100vh;
  background: #f5f5f7;
  padding-bottom: 28rpx;
}

.video-section {
  margin: 20rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow:
    0 14rpx 32rpx rgba(17, 24, 39, 0.16),
    0 4rpx 8rpx rgba(17, 24, 39, 0.1);
  position: relative;
}

.video-player {
  width: 100%;
  height: 420rpx;
  background: #0f172a;
}

.video-mask {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 18rpx;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(6rpx);
  color: #fff;
}

.video-title {
  font-size: 34rpx;
  font-weight: 700;
}

.video-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.action-bar {
  display: flex;
  gap: 12rpx;
  margin: 0 20rpx;
}

.ghost-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 18rpx;
  font-size: 25rpx;
  border: 1rpx solid rgba(60, 60, 67, 0.2);
  background: rgba(255, 255, 255, 0.95);
}

.primary-btn {
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: 0;
  background: #0071e3;
}

.secondary-btn {
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: 1rpx solid rgba(60, 60, 67, 0.22);
  color: #0071e3;
  background: rgba(255, 255, 255, 0.96);
}

.subtitle-panel {
  margin: 16rpx 20rpx;
}

.panel-header {
  color: #6e6e73;
  font-size: 24rpx;
  margin: 10rpx 6rpx 12rpx;
}

.line-item {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(60, 60, 67, 0.12);
  border-radius: 24rpx;
  padding: 22rpx 18rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow:
    0 6rpx 16rpx rgba(15, 23, 42, 0.08),
    0 1rpx 2rpx rgba(15, 23, 42, 0.05);
}

.line-main {
  flex: 1;
  min-width: 0;
}

.line-index {
  font-size: 21rpx;
  color: #8e8e93;
}

.line-text {
  margin-top: 8rpx;
  font-size: 36rpx;
  line-height: 1.3;
  color: #1d1d1f;
  font-weight: 700;
}

.line-transcript {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8e8e93;
}

.line-meta {
  margin-top: 10rpx;
  display: flex;
  justify-content: space-between;
  color: #6e6e73;
  font-size: 21rpx;
}

.mic-btn {
  width: 82rpx;
  height: 82rpx;
  border-radius: 50%;
  background: linear-gradient(160deg, #30d158, #22c55e);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 20rpx rgba(34, 197, 94, 0.28);
  flex-shrink: 0;
}

.mic-btn-recording {
  background: linear-gradient(160deg, #ff4d67, #ff3b30);
  box-shadow: 0 10rpx 20rpx rgba(255, 59, 48, 0.28);
}

.mic-icon {
  color: #fff;
  font-size: 34rpx;
  line-height: 1;
}

.submit-wrap {
  padding: 0 20rpx;
}

.render-btn {
  margin-top: 12rpx;
}

.result-card {
  margin: 16rpx 20rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(60, 60, 67, 0.12);
  border-radius: 24rpx;
  padding: 20rpx;
  box-shadow:
    0 8rpx 20rpx rgba(15, 23, 42, 0.08),
    0 1rpx 2rpx rgba(15, 23, 42, 0.06);
}

.result-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
  color: #1d1d1f;
}

.rendered-video {
  width: 100%;
  height: 320rpx;
  margin-top: 12rpx;
  border-radius: 18rpx;
  background: #0f172a;
}
